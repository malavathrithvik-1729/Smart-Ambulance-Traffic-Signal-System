# ==============================================================================
# TEAM LIFELINE V2 — ENVIRONMENT CONFIGURATION
# Copy this file to .env for local overrides
# ==============================================================================

# Server Network Settings
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000

# Environment: development | production | test
NODE_ENV=development

# Storage Paths
DATABASE_PATH=data/lifeline.sqlite
RECORDINGS_DIR=storage/recordings

# Operational Modes
# When SIMULATION_MODE=true, calls and SMS are handled locally without paid APIs
SIMULATION_MODE=true
REQUIRE_RECORDING_CONSENT=true
RECORDING_RETENTION_HOURS=72

# Security & Secrets
SESSION_SECRET=lifeline-emergency-dispatch-insecure-dev-secret-change-in-prod
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
TRACKING_SESSION_TTL_SECONDS=3600

# Telephony Configuration (Twilio / Compatible Webhook Provider)
# Set to 'twilio' or 'mock'
TELEPHONY_PROVIDER=mock
TWILIO_ACCOUNT_SID=AC_PLACEHOLDER_FOR_VERIFIED_TWILIO_ACCOUNT
TWILIO_AUTH_TOKEN=PLACEHOLDER_TWILIO_AUTH_TOKEN
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_URL=http://localhost:3000/api/telephony/webhook

# SMS Provider Configuration
# Set to 'twilio' or 'mock'
SMS_PROVIDER=mock
SMS_SENDER_ID=LIFELINE

# Speech-to-Text / AI Extraction Configuration
# Set to 'local_rules' or 'mock' or 'whisper' / 'google_cloud'
STT_PROVIDER=local_rules
AI_EXTRACTION_PROVIDER=rule_based
